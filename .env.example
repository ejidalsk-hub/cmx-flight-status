# Flight provider
FLIGHT_PROVIDER=aviationstack
AVIATIONSTACK_API_KEY=your_key_here

# Optional: set to true to show a basic delay/cancellation risk estimate card
ENABLE_RISK_MODEL=true

# NOAA / NWS does not require an API key, but a clear User-Agent is recommended.
APP_USER_AGENT=cmx-flight-status-demo/0.1 (you@example.com)
